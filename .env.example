# Copy to .env and fill in. docker compose reads this file automatically.

# --- AI (required for the AI support agent; without it the chat runs a basic guided flow)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional extra provider (xAI Grok), used if Groq is unavailable
GROK_API_KEY=

# --- Optional overrides
# APP_PORT=8080
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=password
# SUPPORT_EMAIL=support@example.com
# DB_PASSWORD=refunds-secret
# DB_ROOT_PASSWORD=root-secret
